          ".write": "auth != null && ((!data.exists() && newData.hasChildren(['fromId', 'toId', 'text', 'ts']) && root.child('users').child(auth.uid).child('id').val() === newData.child('fromId').val()) || (data.exists() && root.child('users').child(auth.uid).child('id').val() === data.child('toId').val() && newData.child('fromId').val() === data.child('fromId').val() && newData.child('toId').val() === data.child('toId').val() && newData.child('text').val() === data.child('text').val()))"
        }
