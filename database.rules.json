      }
    },
    "reports": {
      ".read": "auth.uid === 'bSfqRHsI3iadcjX56cShfDiuupq1'",
      "$reportId": {
        ".write": "auth != null && ((!data.exists() && newData.hasChildren(['kategori', 'deskripsi', 'pelaporId', 'pelaporNama', 'jenjang', 'createdAt', 'status']) && root.child('users').child(auth.uid).child('id').val() === newData.child('pelaporId').val()) || auth.uid === 'bSfqRHsI3iadcjX56cShfDiuupq1')"
